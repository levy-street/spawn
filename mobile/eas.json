{
  "cli": {
    "version": ">=22.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.19.0",
      "channel": "base"
    },
    "development": {
      "extends": "base",
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "developmentClient": true
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spawnd.dev"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spawnd.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
