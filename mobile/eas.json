{
  "cli": {
    "version": ">=22.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.19.0",
      "channel": "base"
    },
    "development": {
      "extends": "base",
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "developmentClient": true
    },
    "dev-server": {
      "extends": "base",
      "distribution": "internal",
      "channel": "dev-server",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dev.spawnd.dev:8330"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spawnd.dev"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spawnd.dev"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6804522108",
        "appleTeamId": "9RT4S4TGA3"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
