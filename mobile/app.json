{
  "expo": {
    "name": "spawn",
    "slug": "spawn",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "spawn",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.spawnd",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "spawn connects directly to machines you own on your local network."
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "dev.spawnd",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#E11E15"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#030303"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow spawn to attach photos to a terminal session.",
          "cameraPermission": "Allow spawn to take a photo and attach it to a terminal session."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow spawn to scan a machine pairing QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow spawn to unlock with Face ID."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow spawn to access protected credentials with Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E11E15"
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f87ab3b-1f34-4d2b-b1b3-653511c070a0"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8f87ab3b-1f34-4d2b-b1b3-653511c070a0"
    }
  }
}
