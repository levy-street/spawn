{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SPAWN D",
  "version": "0.1.0",
  "identifier": "dev.spawnd.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SPAWN D",
        "width": 780,
        "height": 720,
        "minWidth": 620,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": false,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": false,
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Possess and supervise this Mac with SPAWN D",
    "longDescription": "A menu-bar companion that installs, verifies and supervises the SPAWN D daemon on this Mac.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": null,
      "signingIdentity": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["spawn"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": ["https://spawnd.dev/desktop/latest.json"],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2RjcyN0IxNUVDRjEzQzIKUldUQ0U4OWVzU2YzTnVOTFZRSnpGQ21MRlVWU2lYUk1RRlgxQ2lzc2JTR1duMGQ0Qk5qdC9OWVYK"
    }
  }
}
