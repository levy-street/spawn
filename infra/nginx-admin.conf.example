# Admin subdomain vhost.
#
# Proxies to the SAME Next.js service as the main site; middleware in the web
# app rewrites requests arriving on an `admin.` host to /admin/*. Nothing here
# grants access — the API authorizes every admin request on the account's
# admin flag — so this file is purely about serving the UI on its own origin
# (and therefore its own cookie jar).
#
# Install:
#   sudo cp infra/nginx-admin.conf.example /etc/nginx/sites-available/admin.<domain>
#   sudo ln -s /etc/nginx/sites-available/admin.<domain> /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d admin.<domain>
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name admin.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.example.com;

    ssl_certificate     /etc/letsencrypt/live/admin.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.example.com/privkey.pem;

    location / {
        proxy_pass http://localhost:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket upgrade: the admin origin signs in like any other client.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
