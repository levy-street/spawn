# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.python-version
.env
.env.*
!.env.example

# uv
.uv/

# Rust
target/
**/*.rs.bk

# Node / Bun
node_modules/
.next/
out/
.turbo/
dist/
build/
*.tsbuildinfo
.bun/
bun.lockb
test-results/
playwright-report/
coverage/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp
*~
.eslintcache

# Merge and edit leftovers. `git add -A` after a conflict is how these land.
# The vendored sctp crate ships a real Cargo.toml.orig, so exempt the vendor tree.
*.orig
*.rej
*.bak
!daemon/vendor/**/*.orig

# Local data
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
server/data/
data/postgres/
data/redis/

# Spawn local state
.spawn/

# Logs, wherever a script or a daemon drops one.
*.log

# Local agent workspace: worktrees, settings, and mailbox state. Never
# something a clone or a contributor's `git add -A` should pick up.
.claude/
.claude-flow/
# Planning scaffolding written by the GSD tooling, per-checkout and disposable.
.planning/

# Downloaded credential files: never let `git add -A` publish one.
*credentials.csv
*.pem
# Apple signing keys (Sign in with Apple, APNs, App Store Connect API).
# Downloadable exactly once, and authenticate as you — never in the tree.
*.p8
# Google service-account keys (Play submissions, FCM sending). These authorise
# uploads and pushes as you; they belong in ~/.spawn/google/, never in the tree.
*service-account*.json
*-service_account*.json

# Reference screenshots dropped in the repo root
Screenshot *.png

# Apple credentials and certificates belong in ~/.spawn/apple, never here. A
# stray .cer at the root is how one gets swept into a `git add -A` — which is
# exactly how aps.cer reached this history.
/*.cer
/*.p12
/*.p8
/*.mobileprovision

# Expo's shared project state, written by the CLI beside mobile/.expo/.
.expo-shared/

# The WiX toolset scripts/publish-desktop.sh downloads to build the Windows
# installer. Tens of megabytes of vendor binaries, refetched on demand.
desktop/src-tauri/WixTools/
