{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {erlexec, "2.3.0"},
    {gun, "2.2.0"},
    {thoas, "1.2.1"}
]}.

{relx, [
    {release, {spawnd, "0.2.0"}, [spawnd, sasl]},
    {dev_mode, false},
    {include_erts, true},
    {extended_start_script, true}
]}.

{escript_name, spawnd}.
{escript_main_app, spawnd}.
{escript_incl_apps, [inets, ssl, crypto, public_key, sasl, erlexec, gun, thoas]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info]},
        {deps, []}
    ]}
]}.
