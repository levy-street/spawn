# spawn-server
SPAWN_DATABASE_URL=postgresql+asyncpg://spawn:spawn@localhost:5432/spawn
SPAWN_REDIS_URL=redis://localhost:6379/0

# JWT signing key (generate with: python -c 'import secrets; print(secrets.token_urlsafe(64))')
SPAWN_JWT_SECRET=change-me-in-prod-please-this-is-only-for-local

# Public-facing URL the daemon and browser will hit
SPAWN_PUBLIC_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the API with credentials
SPAWN_CORS_ORIGINS=http://localhost:3000

# Web app
NEXT_PUBLIC_SPAWN_API_URL=http://localhost:8000
NEXT_PUBLIC_SPAWN_WS_URL=ws://localhost:8000
